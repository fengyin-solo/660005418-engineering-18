# 前端本地开发联调配置（复制为 .env.development 后生效）
# Vite 只向客户端暴露 VITE_ 前缀变量。

# dev server 监听端口（浏览器访问端口）
VITE_DEV_PORT=3000

# 日志接口（FastAPI）地址，作为 /api 与 /ws 的代理目标。
# 必须与 backend/.env 中的 LOG_API_HOST / LOG_API_PORT 保持一致。
VITE_LOG_API_TARGET=http://127.0.0.1:8000

# 前端请求日志接口时使用的 baseURL：
#   走 Vite 代理时保持 /api 即可（推荐，无跨域问题）；
#   直连后端时改成完整地址，例如 http://127.0.0.1:8000/api。
VITE_LOG_API_BASE=/api
