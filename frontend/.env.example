# 前端开发环境配置示例：复制为 frontend/.env 后按需修改
# 同名 shell 环境变量优先级高于本文件

# 前端开发服务器端口（scripts/dev.sh 与 vite 共用此值）
VITE_DEV_PORT=3000

# 后端日志接口地址：Vite 开发代理将 /api、/ws 转发到该地址
# 需与 backend/.env 的 BACKEND_HOST/BACKEND_PORT 对应；
# 未设置时 scripts/dev.sh 会按后端配置自动推导
VITE_BACKEND_URL=http://127.0.0.1:8000

# 前端请求日志接口的路径前缀，默认走 Vite 代理；
# 如需直连后端（跨机部署等），改为 http://<后端地址>:<端口>/api
VITE_API_BASE_URL=/api
